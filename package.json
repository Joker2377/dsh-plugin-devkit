{
  "name": "dsh-plugin-devkit",
  "version": "0.4.0",
  "description": "Scaffold a DeepSeek Harness bundle, diagnose one before you install it, audit a published package's supply chain, and confirm what actually loaded — four host tools (plugin_scaffold, plugin_doctor, plugin_audit) plus a CLI.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/checks.js": "./lib/checks.js",
    "./lib/semver.js": "./lib/semver.js",
    "./lib/audit.js": "./lib/audit.js",
    "./lib/audit-report.js": "./lib/audit-report.js",
    "./lib/spec.js": "./lib/spec.js",
    "./lib/registry.js": "./lib/registry.js",
    "./lib/profile.js": "./lib/profile.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-plugin-devkit": "./scripts/cli.mjs"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "bundle",
    "scaffold",
    "devkit",
    "lint",
    "audit",
    "supply-chain",
    "npm"
  ],
  "author": "Joker2377",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joker2377/dsh-plugin-devkit.git"
  },
  "homepage": "https://github.com/Joker2377/dsh-plugin-devkit#readme",
  "bugs": {
    "url": "https://github.com/Joker2377/dsh-plugin-devkit/issues"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.1.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:sandbox": "node --test --experimental-test-isolation=none \"test/**/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
